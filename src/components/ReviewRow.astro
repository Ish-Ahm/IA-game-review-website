---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Rating from "./Rating.astro";

interface Props {
	review: CollectionEntry<"reviews">;
}

const { review } = Astro.props;
const { title, rating, enjoyment, year, developer, platform, status, cover, summary } = review.data;
const href = `/reviews/${review.id}`;
// The line under the title, for example "Remedy Entertainment · 2019 · PS5 · Completed".
// Anything left blank is skipped.
const subtitle = [developer, year, platform, status].filter(Boolean).join(" \u00b7 ");
const detailId = `review-detail-${review.id}`;

// A short preview taken from the first paragraph of the review (skipping
// spoiler blocks and other HTML), with basic Markdown symbols removed.
const firstParagraph =
	(review.body ?? "")
		.split(/\n\s*\n/)
		.map((block) => block.trim())
		.find((block) => block && !block.startsWith("<")) ?? "";
const plain = firstParagraph
	.replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
	.replace(/[*_`#>]/g, "")
	.replace(/\s+/g, " ")
	.trim();
const autoExcerpt = plain.length > 320 ? `${plain.slice(0, 320).replace(/\s+\S*$/, "")}…` : plain;
const excerpt = summary?.trim() || autoExcerpt;
---

<tr
	class="review-row"
	data-title={title.toLowerCase()}
	data-platform={platform.toLowerCase()}
	data-status={status}
	data-year={year ?? ""}
	data-detail={detailId}
>
	<td class="review-row__cover">
		<span class="review-row__thumb">
			{
				cover ? (
					<Image src={cover} alt="" width={64} height={88} class="review-row__image" />
				) : (
					<span class="review-row__placeholder"></span>
				)
			}
		</span>
	</td>
	<td class="review-row__title" title={title}>
		<button type="button" class="review-row__toggle" aria-expanded="false" aria-controls={detailId}>
			{title}
		</button>
	</td>
	<td class="review-row__year">{year ?? "—"}</td>
	<td class="review-row__platform" title={platform}>{platform}</td>
	<td class="review-row__rating" title={rating}><Rating value={rating} /></td>
	<td class="review-row__enjoyment" title={enjoyment ?? undefined}>{enjoyment ? <Rating value={enjoyment} /> : "—"}</td>
	<td class="review-row__status">{status}</td>
</tr>
<tr class="review-detail" id={detailId}>
	<td colspan="7">
		<!-- Collapsed by default (max-height: 0). The script animates it open
		     and closed instead of showing or hiding it immediately. -->
		<div class="review-detail__collapse">
			<div class="review-detail__collapse-inner">
				<div class="review-detail__panel">
					<div class="review-detail__cover">
						{
							cover ? (
								<Image src={cover} alt={`Cover art for ${title}`} width={300} class="review-detail__image" />
							) : (
								<div class="review-detail__placeholder" aria-hidden="true"></div>
							)
						}
					</div>

					<div class="review-detail__content">
						<h2 class="review-detail__title">{title}</h2>
						<p class="review-detail__meta">{subtitle}</p>

						<div class="review-detail__scores">
							<div class="review-detail__score">
								<span class="review-detail__score-label">Overall rating</span>
								<span class="review-detail__score-value"><Rating value={rating} /></span>
							</div>
							{
								enjoyment && (
									<div class="review-detail__score">
										<span class="review-detail__score-label">Enjoyment rating</span>
										<span class="review-detail__score-value"><Rating value={enjoyment} /></span>
									</div>
								)
							}
							<a class="review-detail__link" href={href}>Read full review</a>
						</div>

						{excerpt && <p class="review-detail__excerpt">{excerpt}</p>}
					</div>
				</div>
			</div>
		</div>
	</td>
</tr>

<style>
	.review-row {
		border-bottom: var(--row-line-width) solid var(--color-border-strong);
		cursor: pointer;
	}

	.review-row:hover {
		background: var(--color-surface-hover);
	}

	.review-row td {
		padding: var(--space-3) var(--space-2);
		vertical-align: middle;
		/* Text that is too long for its column is cut off with an ellipsis */
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.review-row__cover {
		width: 3.5rem;
	}

	.review-row__thumb {
		display: block;
		width: 2rem;
		height: 2.75rem;
	}

	.review-row__image,
	.review-row__placeholder {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0.25rem;
	}

	.review-row__placeholder {
		background: var(--color-border);
	}

	/* Keep manual line breaks in ratings, but never wrap: each line is cut off with an ellipsis */
	.review-row__rating :global(.rating),
	.review-row__enjoyment :global(.rating) {
		white-space: pre;
	}

	/* The game name is a real button (for keyboard users), styled as plain text.
	   Clicking anywhere on the row does the same thing. */
	.review-row__toggle {
		display: block;
		max-width: 100%;
		padding: 0;
		background: none;
		border: 0;
		color: var(--color-text);
		font: inherit;
		font-weight: 600;
		text-align: left;
		cursor: pointer;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.review-row__platform,
	.review-row__enjoyment,
	.review-row__status {
		color: var(--color-text-muted);
	}

	.review-row__year {
		font-family: var(--font-mono);
		font-size: 0.9rem;
		color: var(--color-text-muted);
		white-space: nowrap;
	}

	/* The expanded panel that opens under a row */
	.review-detail > td {
		padding: 0;
	}

	/* Collapsed to no height by default. The script sets an explicit pixel
	   height when opening or closing, so the height change can transition;
	   "max-height: 0" alone cannot be animated to "auto". */
	.review-detail__collapse {
		max-height: 0;
		overflow: hidden;
		opacity: 0;
		transition:
			max-height 0.25s ease,
			opacity 0.2s ease;
	}

	.review-detail__collapse.is-open {
		opacity: 1;
	}

	.review-detail__collapse-inner {
		padding: var(--space-3) 0 var(--space-4);
		border-bottom: var(--row-line-width) solid var(--color-border-strong);
	}

	.review-detail__panel {
		display: flex;
		gap: var(--space-5);
		padding: var(--space-4);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
	}

	.review-detail__cover {
		flex: 0 0 18rem;
	}

	/* The cover keeps its own proportions, so it is never cropped */
	.review-detail__image {
		display: block;
		width: 100%;
		height: auto;
		border-radius: var(--radius);
	}

	/* The empty box used when a review has no cover */
	.review-detail__placeholder {
		width: 100%;
		aspect-ratio: 3 / 4;
		background: var(--color-border);
		border-radius: var(--radius);
	}

	.review-detail__content {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	.review-detail__title {
		margin: 0;
		font-size: 1.75rem;
		line-height: 1.2;
	}

	.review-detail__meta {
		margin: 0;
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.review-detail__scores {
		display: flex;
		align-items: center;
		gap: var(--space-6);
		padding: var(--space-4);
		background: var(--color-surface-hover);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
	}

	.review-detail__score {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		min-width: 0;
	}

	.review-detail__score-label {
		color: var(--color-text-muted);
		font-size: 0.8rem;
		font-weight: 1000;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.review-detail__score-value {
		font-size: 1.6rem;
		line-height: 1.2;
	}

	.review-detail__excerpt {
		margin: 0;
		color: var(--color-text);
		white-space: pre-line; /* lets a line break typed in the frontmatter show as one */
		margin-top: 1rem
	}

	/* Pushed to the far right of the scores box */
	.review-detail__link {
		margin-left: auto;
		padding: var(--space-2) var(--space-3);
		border: 1px solid var(--color-border-strong);
		border-radius: var(--radius);
		white-space: nowrap;
		text-decoration: none;
		transition: background-color 0.15s ease, border-color 0.15s ease;
	}

	.review-detail__link:hover,
	.review-detail__link:focus-visible {
		background: #ae54004d; /* AE5400 at 30% opacity (4d = 77/255 ≈ 30%) */
		border-color: #ff8412;
		text-decoration: none;
	}

	@media (max-width: 40rem) {
		.review-detail__panel {
			flex-direction: column;
		}

		.review-detail__cover {
			flex-basis: auto;
			max-width: 12rem;
		}
	}
</style>
