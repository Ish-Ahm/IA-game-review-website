---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Rating from "./Rating.astro";

interface Props {
	review: CollectionEntry<"reviews">;
}

const { review } = Astro.props;
const { title, rating, enjoyment, year, platform, status, cover } = review.data;
const href = `/reviews/${review.id}`;
---

<tr
	class="review-row"
	data-title={title.toLowerCase()}
	data-platform={platform.toLowerCase()}
	data-status={status}
	data-year={year ?? ""}
>
	<td class="review-row__cover">
		<a href={href} tabindex="-1" aria-hidden="true">
			{
				cover ? (
					<Image src={cover} alt="" width={64} height={88} class="review-row__image" />
				) : (
					<span class="review-row__placeholder"></span>
				)
			}
		</a>
	</td>
	<td class="review-row__title" title={title}><a href={href}>{title}</a></td>
	<td class="review-row__year">{year ?? "\u2014"}</td>
	<td class="review-row__platform" title={platform}>{platform}</td>
	<td class="review-row__rating" title={rating}><Rating value={rating} /></td>
	<td class="review-row__enjoyment" title={enjoyment ?? undefined}>{enjoyment ? <Rating value={enjoyment} /> : "\u2014"}</td>
	<td class="review-row__status">{status}</td>
</tr>

<style>
	.review-row {
		border-bottom: var(--row-line-width) solid var(--color-border-strong);
	}

	.review-row:hover {
		background: var(--color-surface-hover);
	}

	.review-row td {
		padding: var(--space-3) var(--space-2);
		vertical-align: middle;
		/* Text that is too long for its column is cut off with an ellipsis */
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.review-row__cover {
		width: 3.5rem;
	}

	.review-row__cover a {
		display: block;
		width: 2rem;
		height: 2.75rem;
	}

	.review-row__image,
	.review-row__placeholder {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0.25rem;
	}

	.review-row__placeholder {
		background: var(--color-border);
	}

	/* Keep manual line breaks in ratings, but never wrap: each line is cut off with an ellipsis */
	.review-row__rating :global(.rating),
	.review-row__enjoyment :global(.rating) {
		white-space: pre;
	}

	.review-row__title a {
		color: var(--color-text);
		font-weight: 600;
	}

	.review-row__platform,
	.review-row__enjoyment,
	.review-row__status {
		color: var(--color-text-muted);
	}

	.review-row__year {
		font-family: var(--font-mono);
		font-size: 0.9rem;
		color: var(--color-text-muted);
		white-space: nowrap;
	}
</style>
