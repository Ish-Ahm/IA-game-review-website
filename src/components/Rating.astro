---
// Shows the custom rating text, for example "Superb".
interface Props {
	value: string;
}

const { value } = Astro.props;
---

<span class="rating">{value}</span>

<style>
	.rating {
		white-space: pre-line; /* lets a line break in the text show as a real line break */
		font-weight: bold;
		color: var(--color-highlight);
	}
</style>
