---
// The site header: site name and main navigation.
---

<header class="site-header">
	<a class="site-header__title" href="/">My Game Reviews</a>
	<nav class="site-header__nav" aria-label="Main">
		<a href="/">Home</a>
		<a href="/about">About</a>
	</nav>
</header>

<style>
	.site-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--space-3);
		max-width: var(--content-max-width);
		width: 100%;
		margin: 0 auto;
		padding: var(--space-3);
	}

	.site-header__title {
		font-weight: bold;
	}

	.site-header__nav {
		display: flex;
		gap: var(--space-3);
	}
</style>
