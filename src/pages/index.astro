---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import ReviewRow from "../components/ReviewRow.astro";
import { PLATFORM_OPTIONS, STATUS_OPTIONS } from "../content.config";

// Load every review and sort alphabetically by title.
const reviews = (await getCollection("reviews")).sort((a, b) => a.data.title.localeCompare(b.data.title));

// Cover art for the collage beside the intro, up to 12 games.
const collage = reviews.filter((r) => r.data.cover).slice(0, 12);
---

<BaseLayout title="My Game Reviews" description="Personal reviews of games I have played.">
	<section class="intro">
		<div class="intro__text">
			<h1 class="intro__title">My Games &amp; Reviews</h1>
			<p class="intro__description">
				Reviews of {reviews.length} games I have played over the years, including ratings, notes and
				where I played them. Placeholder text: replace this with your own introduction.
			</p>
		</div>

		<div class="collage" aria-hidden="true">
			{
				collage.map((review) => (
					<Image src={review.data.cover!} alt="" width={140} height={200} class="collage__image" />
				))
			}
		</div>
	</section>

	<!-- Both dropdowns tick any number of options, and narrow the table to
	     rows matching at least one ticked option in each. -->
	<div class="filters" role="group" aria-label="Filter reviews">
		<div class="filters__group">
			<button
				type="button"
				class="filters__trigger"
				id="status-filter-button"
				aria-haspopup="true"
				aria-expanded="false"
				aria-controls="status-filter-menu"
			>
				Status <span class="filters__arrow" aria-hidden="true">{"▾"}</span>
			</button>
			<div class="filters__menu" id="status-filter-menu" hidden>
				{
					STATUS_OPTIONS.map((option) => (
						<label class="filters__option">
							<input type="checkbox" value={option} />
							{option}
						</label>
					))
				}
			</div>
		</div>

		<div class="filters__group">
			<button
				type="button"
				class="filters__trigger"
				id="platform-filter-button"
				aria-haspopup="true"
				aria-expanded="false"
				aria-controls="platform-filter-menu"
			>
				Platform <span class="filters__arrow" aria-hidden="true">{"▾"}</span>
			</button>
			<div class="filters__menu" id="platform-filter-menu" hidden>
				{
					PLATFORM_OPTIONS.map((option) => (
						<label class="filters__option">
							<input type="checkbox" value={option} />
							{option}
						</label>
					))
				}
			</div>
		</div>
	</div>

	<table class="review-table">
		<colgroup>
			<col class="review-table__col-cover" />
			<col class="review-table__col-game" />
			<col class="review-table__col-year" />
			<col class="review-table__col-platform" />
			<col class="review-table__col-overall" />
			<col class="review-table__col-enjoyment" />
			<col class="review-table__col-status" />
		</colgroup>
		<thead>
			<tr>
				<th scope="col"><span class="visually-hidden">Cover</span></th>
				<th scope="col"><button type="button" class="sort" data-sort="title">Game</button></th>
				<th scope="col"><button type="button" class="sort" data-sort="year">Year</button></th>
				<th scope="col">Platform</th>
				<th scope="col">Overall rating</th>
				<th scope="col">Enjoyment rating</th>
				<th scope="col">Status</th>
			</tr>
		</thead>
		<tbody>
			{reviews.map((review) => <ReviewRow review={review} />)}
		</tbody>
	</table>
	<p class="review-table__empty" hidden>No reviews match your search.</p>
</BaseLayout>

<style>
	.intro {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		flex-wrap: wrap;
		gap: var(--space-5);
		padding-bottom: var(--space-5);
		border-bottom: 1px solid var(--color-border);
	}

	.intro__text {
		flex: 1 1 24rem;
		max-width: 32rem;
	}

	.intro__title {
		margin: 0 0 var(--space-3);
		font-size: 2.25rem;
		line-height: 1.1;
	}

	.intro__description {
		margin: 0 0 var(--space-4);
		color: var(--color-text-muted);
		font-size: 1.1rem;
	}

	/* The Status and Platform filter dropdowns, styled as one pill-shaped box
	   like the site's other controls. */
	.filters {
		display: flex;
		width: fit-content;
		margin: var(--space-4) 0;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
	}

	.filters__group {
		position: relative;
		border-right: 1px solid var(--color-border);
	}

	.filters__group:last-child {
		border-right: 0;
	}

	.filters__trigger {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-2) var(--space-3);
		background: transparent;
		color: var(--color-text-muted);
		border: 0;
		font: inherit;
		cursor: pointer;
	}

	.filters__group:first-child .filters__trigger {
		border-radius: var(--radius) 0 0 var(--radius);
	}

	.filters__group:last-child .filters__trigger {
		border-radius: 0 var(--radius) var(--radius) 0;
	}

	.filters__trigger[aria-expanded="true"],
	.filters__trigger.has-selection {
		background: var(--color-surface);
		color: var(--color-text);
	}

	.filters__arrow {
		display: inline-block;
		font-size: 1.3em;
		font-weight: 900;
		color: var(--color-highlight);
	}

	.filters__count {
		font-family: var(--font-mono);
		font-weight: bold;
		color: var(--color-highlight);
	}

	.filters__menu {
		position: absolute;
		top: calc(100% + var(--space-2));
		left: 0;
		z-index: 1;
		flex-direction: column;
		gap: var(--space-1);
		min-width: 10rem;
		padding: var(--space-2);
		background: var(--color-surface);
		border: 1px solid var(--color-border-strong);
		border-radius: var(--radius);
		box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.4);
	}

	/* Only laid out as a flex column once the "hidden" attribute is removed;
	   otherwise the "display: flex" above would override the browser's
	   built-in rule for [hidden] and the menu would never actually hide. */
	.filters__menu:not([hidden]) {
		display: flex;
	}

	.filters__option {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-1) var(--space-2);
		color: var(--color-text);
		cursor: pointer;
		border-radius: var(--radius);
	}

	.filters__option:hover {
		background: var(--color-surface-hover);
	}

	.collage {
		display: grid;
		grid-template-columns: repeat(6, 4.5rem);
		gap: var(--space-2);
	}

	.collage__image {
		width: 100%;
		aspect-ratio: 5 / 7;
		object-fit: cover;
		border: 1px solid var(--color-border);
		border-radius: 0.25rem;
	}

	.review-table {
		width: 100%;
		table-layout: fixed; /* column widths below are respected exactly */
		margin-top: var(--space-4);
		border-collapse: collapse;
		text-align: left;
		font-family: var(--font-mono);
		font-size: 0.9rem; /* the table's old "year" size, now used everywhere except the game name */
	}

	.review-table__col-cover {
		width: 3.5rem;
	}

	/* Fixed column widths. Long text is cut off with an ellipsis. The Status column
	   (no width set) takes whatever space is left over. */
	.review-table__col-game {
		width: 30%;
	}

	.review-table__col-year {
		width: 10%;
	}

	.review-table__col-platform {
		width: 12%;
	}

	.review-table__col-overall,
	.review-table__col-enjoyment {
		width: 19%;
	}

	.review-table__col-status {
		width: 10%;
	}

	.review-table th {
		padding: var(--space-3) var(--space-2);
		border-bottom: var(--row-line-width) solid var(--color-border-strong);
		color: var(--color-text-muted);
		font-weight: 700;
		font-size: 0.9rem;
		text-transform: uppercase;
	}

	.sort {
		padding: 0;
		background: none;
		border: 0;
		color: inherit;
		font: inherit;
		text-transform: inherit; /* buttons ignore the header's capitals unless told to inherit */
		cursor: pointer;
	}

	.sort::after {
		content: " \2195";
		display: inline-block;
		font-size: 1.3em;
		font-weight: 900;
		color: var(--color-highlight);
	}

	.sort[data-direction="asc"]::after {
		content: " \2191";
	}

	.sort[data-direction="desc"]::after {
		content: " \2193";
	}

	.review-table__empty {
		color: var(--color-text-muted);
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	@media (max-width: 40rem) {
		.collage {
			display: none;
		}
	}
</style>

<script>
	// Small, framework-free script: filter tabs, search and sortable columns.
	const table = document.querySelector<HTMLTableElement>(".review-table")!;
	const body = table.tBodies[0];
	const rows = Array.from(body.querySelectorAll<HTMLTableRowElement>("tr.review-row"));
	// Each row has a hidden "detail" row after it, which opens when the row is clicked.
	const detailFor = (row: HTMLTableRowElement) => document.getElementById(row.dataset.detail!)!;
	const toggleFor = (row: HTMLTableRowElement) => row.querySelector<HTMLButtonElement>(".review-row__toggle")!;
	const emptyMessage = document.querySelector<HTMLElement>(".review-table__empty")!;
	const searchInput = document.querySelector<HTMLInputElement>("#site-search");

	let query = new URLSearchParams(location.search).get("q")?.toLowerCase().trim() ?? "";
	if (searchInput && query) searchInput.value = query;

	// Sets up one filter dropdown (Status or Platform): opening and closing it,
	// closing it when another one opens or the page is clicked elsewhere, and
	// tracking which options are ticked. Returns that set of ticked, lowercase
	// option values, which applyFilters below reads directly.
	function setupFilterDropdown(id: string) {
		const button = document.querySelector<HTMLButtonElement>(`#${id}-button`)!;
		const menu = document.querySelector<HTMLElement>(`#${id}-menu`)!;
		const checkboxes = Array.from(menu.querySelectorAll<HTMLInputElement>('input[type="checkbox"]'));
		const selected = new Set<string>();

		button.addEventListener("click", (event) => {
			event.stopPropagation();
			const open = menu.hidden;
			closeAllFilterMenus();
			menu.hidden = !open;
			button.setAttribute("aria-expanded", String(open));
		});

		for (const checkbox of checkboxes) {
			checkbox.addEventListener("change", () => {
				const value = checkbox.value.toLowerCase();
				if (checkbox.checked) {
					selected.add(value);
				} else {
					selected.delete(value);
				}
				button.classList.toggle("has-selection", selected.size > 0);
				applyFilters();
			});
		}

		return selected;
	}

	function closeAllFilterMenus() {
		for (const menu of document.querySelectorAll<HTMLElement>(".filters__menu")) menu.hidden = true;
		for (const button of document.querySelectorAll<HTMLButtonElement>(".filters__trigger")) {
			button.setAttribute("aria-expanded", "false");
		}
	}

	// Close an open dropdown when clicking anywhere outside the filter bar.
	document.addEventListener("click", (event) => {
		if (!(event.target as Element).closest(".filters")) closeAllFilterMenus();
	});

	const selectedStatuses = setupFilterDropdown("status-filter");
	const selectedPlatforms = setupFilterDropdown("platform-filter");

	function applyFilters() {
		let visible = 0;
		for (const row of rows) {
			const status = (row.dataset.status ?? "").toLowerCase();
			const matchesStatus = selectedStatuses.size === 0 || selectedStatuses.has(status);
			const platforms = (row.dataset.platforms ?? "").split(",");
			const matchesPlatform =
				selectedPlatforms.size === 0 || platforms.some((p) => selectedPlatforms.has(p));
			const text = `${row.dataset.title} ${row.dataset.platforms}`;
			const matchesSearch = !query || text.includes(query);
			row.hidden = !(matchesStatus && matchesPlatform && matchesSearch);
			// The detail row simply follows the review row; whether it is open or
			// closed is handled separately, by setOpen below.
			detailFor(row).hidden = row.hidden;
			if (!row.hidden) visible++;
		}
		emptyMessage.hidden = visible > 0;
	}

	// Filter live while typing, instead of reloading the page.
	searchInput?.addEventListener("input", () => {
		query = searchInput.value.toLowerCase().trim();
		applyFilters();
	});
	searchInput?.form?.addEventListener("submit", (event) => event.preventDefault());

	// Clicking anywhere on a row opens or closes its detail panel, animating
	// the height instead of showing or hiding it immediately.
	function setOpen(row: HTMLTableRowElement, open: boolean) {
		const toggle = toggleFor(row);
		toggle.setAttribute("aria-expanded", String(open));
		const collapse = detailFor(row).querySelector<HTMLElement>(".review-detail__collapse")!;
		if (open) {
			collapse.classList.add("is-open");
			collapse.style.maxHeight = `${collapse.scrollHeight}px`;
		} else {
			// Start from the panel's actual height so the shrink can transition,
			// then collapse it on the next frame.
			collapse.style.maxHeight = `${collapse.scrollHeight}px`;
			requestAnimationFrame(() => {
				collapse.classList.remove("is-open");
				collapse.style.maxHeight = "0px";
			});
		}
	}

	for (const row of rows) {
		const collapse = detailFor(row).querySelector<HTMLElement>(".review-detail__collapse")!;
		// Once fully open, let the panel grow or shrink naturally (for example if
		// the window is resized), instead of staying locked to the opening height.
		collapse.addEventListener("transitionend", (event) => {
			if (event.propertyName === "max-height" && collapse.classList.contains("is-open")) {
				collapse.style.maxHeight = "none";
			}
		});

		row.addEventListener("click", () => {
			const open = toggleFor(row).getAttribute("aria-expanded") !== "true";
			setOpen(row, open);
		});
	}

	const sortButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".sort"));
	for (const button of sortButtons) {
		button.addEventListener("click", () => {
			const key = button.dataset.sort!;
			const direction = button.dataset.direction === "asc" ? "desc" : "asc";
			sortButtons.forEach((b) => delete b.dataset.direction);
			button.dataset.direction = direction;

			const numeric = key === "year";
			const value = (row: HTMLTableRowElement) => row.dataset[key] ?? "";
			rows.sort((a, b) => {
				const result = numeric ? Number(value(a)) - Number(value(b)) : value(a).localeCompare(value(b));
				return direction === "asc" ? result : -result;
			});
			rows.forEach((row) => {
				body.appendChild(row);
				body.appendChild(detailFor(row));
			});
		});
	}

	applyFilters();
</script>
