---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ReviewCard from "../components/ReviewCard.astro";

// Load every review and sort by the date played, newest first.
const reviews = (await getCollection("reviews")).sort(
	(a, b) => b.data.played.valueOf() - a.data.played.valueOf(),
);
---

<BaseLayout title="My Game Reviews" description="Personal reviews of games I have played.">
	<h1>My Game Reviews</h1>
	<p>Honest thoughts on the games I have played, with ratings and notes.</p>

	<div class="review-grid">
		{reviews.map((review) => <ReviewCard review={review} />)}
	</div>
</BaseLayout>

<style>
	.review-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
		gap: var(--space-4);
		margin-top: var(--space-4);
	}
</style>
