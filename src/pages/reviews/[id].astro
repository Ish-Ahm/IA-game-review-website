---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Rating from "../../components/Rating.astro";

// Tell Astro to build one page per review.
export async function getStaticPaths() {
	const reviews = await getCollection("reviews");
	return reviews.map((review) => ({
		params: { id: review.id },
		props: { review },
	}));
}

const { review } = Astro.props;
const { title, rating, enjoyment, year, developer, platform, status, cover } = review.data;
const { Content } = await render(review);
---

<BaseLayout title={`${title} | My Game Reviews`} description={`My review of ${title}.`}>
	<article class="review">
		<h1 class="review__title">{title}</h1>

		<div class="review__cover">
			{
				cover ? (
					<Image src={cover} alt={`Cover art for ${title}`} width={300} />
				) : (
					<div class="review__cover-placeholder" aria-hidden="true" />
				)
			}
		</div>

		<dl class="review__details">
			<dt>Overall rating</dt>
			<dd><Rating value={rating} /></dd>
			{enjoyment && <dt>Enjoyment rating</dt><dd><Rating value={enjoyment} /></dd>}
			{developer && <dt>Developer</dt><dd>{developer}</dd>}
			{year && <dt>Year</dt><dd>{year}</dd>}
			<dt>Platform</dt>
			<dd>{platform.join(", ")}</dd>
			<dt>Status</dt>
			<dd>{status}</dd>
		</dl>

		<div class="review__body">
			<Content />
		</div>

		<p><a href="/">Back to all reviews</a></p>
	</article>
</BaseLayout>

<style>
	.review__cover {
		margin-bottom: var(--space-4);
	}

	.review__cover-placeholder {
		width: 12rem;
		aspect-ratio: 3 / 4;
		background: var(--color-border);
		border-radius: var(--radius);
	}

	.review__details {
		display: grid;
		grid-template-columns: max-content 1fr;
		gap: var(--space-1) var(--space-4);
		margin: 0 0 var(--space-4);
	}

	.review__details dt {
		color: var(--color-text-muted);
	}

	.review__details dd {
		margin: 0;
	}

	/* Spoiler sections: <details> blocks written in the Markdown. The :global is
	   needed because the Markdown is rendered outside this component's scope. */
	.review__body :global(details) {
		margin: var(--space-4) 0;
		padding: var(--space-3);
		background: var(--color-surface);
		border: var(--row-line-width) solid var(--color-border-strong);
		border-radius: var(--radius);
	}

	.review__body :global(summary) {
		cursor: pointer;
		font-weight: 600;
	}

	.review__body :global(details[open] > summary) {
		margin-bottom: var(--space-3);
	}
</style>
